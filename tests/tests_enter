driver = webdriver.Chrome() # вход по кнопке «Войти в аккаунт» на главной

driver.get("https://stellarburgers.education-services.ru/")

driver.find_element(By.XPATH, "//button[text()='Войти в аккаунт']").click()

driver.find_element(By.XPATH, "//fieldset[1]//input").send_keys("Alex_Tokmakov_43_357@yandex.ru")
driver.find_element(By.XPATH, "//fieldset[2]//input").send_keys("426761")
driver.find_element(By.CSS_SELECTOR, ".button_button__33qZ0").click()

driver.find_element(By.CSS_SELECTOR, ".AppHeader_header__linkText__3q_va").click()

button = driver.find_elements(By.CSS_SELECTOR, ".Account_button__14Yp3")
assert button is not None

driver.quit()

